        num_1_mod_3=num_1_mod_3,
        num_2_mod_3=num_2_mod_3)
    
    CR_MAX, PRIME_MAX = estimate_cache_sizes(
        number_of_primes,
        primes=(p1, p2),
        prime_above_cache=prime_above_cache,
        num_1_mod_3=num_1_mod_3,
        num_2_mod_3=num_2_mod_3)
        
    print(f"Running num_1_mod_3={num_1_mod_3}, num_2_mod_3={num_2_mod_3} "
          f"batch_size={batch_size}, CR_MAX={CR_MAX}, PRIME_MAX={PRIME_MAX}")

    main_parallel(
        number_of_primes=number_of_primes,
        N=N,
        num_1_mod_3=num_1_mod_3,
        num_2_mod_3=num_2_mod_3,
        out_file=out_file,
        batch_size=batch_size,
        nprocesses=min(os.cpu_count(), 64),
        cache_limits=(CR_MAX, PRIME_MAX),
        debug=True,
        primes=(p1, p2),
        prime_above_cache=prime_above_cache
    )
       
